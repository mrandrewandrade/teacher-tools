  "dependencies": {
    "qr-code-styling": "1.9.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}

